    "README.md",
    "README-TEMPLATE.md",
    "AGENTS.md",
    "CHECKLIST.md",
    "HOOKS.md",
    "UPDATING.md",
    "CHANGELOG.md",
    "MULTI-PROVIDER.md",
    "NOTICE.md",
    "LICENSE",
    "extract-contract.py",
    "registry-entry.json",
    "tests",
    "scripts",
    "examples",
    "GUIDE.md",
    "OFFICIAL-SOURCES.md",
    "SCORING.md",
    "CONTRIBUTING.md"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "opencode",
    "opencode-plugin",
    "opencode-auth",
    "provider",
    "marvis",
    "tencent",
    "deepseek"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
